---
title: AOD - end-to-end flow with the frontend, Riot API implemented (2026-09-10)
config:
  layout: elk
---
%% Riot-aware variant of the frontend flow. Magenta nodes are the Riot API
%% integration; everything else matches the shipped prototype flow.
flowchart TD
    subgraph Legend ["Legend"]
        direction LR
        Lg1["React + Vite client"]:::frontendNode
        Lg2["Laravel API / queue worker"]:::processNode
        Lg3["Database table"]:::dataNode
        Lg4["Decision point"]:::decisionNode
        Lg5["Riot API integration"]:::riotNode
    end

    Start([Start]) --> FEOpen["React client (Vite build) loads;<br/>React Router shows the log-in or sign-up route"]
    FEOpen --> CheckAccount{"Already have<br/>an account?"}

    CheckAccount -->|Yes| FELoginForm["Log-in form: React Hook Form + Zod<br/>validate email and password in the browser"]
    FELoginForm --> FELoginCall["Axios POST /api/login"]
    FELoginCall --> ValidateCredentials["API checks the credentials"]
    ValidateCredentials --> IssueToken["API issues an access token,<br/>marks the user online"]
    IssueToken --> FEStoreToken["Client stores the token, sets the Axios<br/>auth header, seeds TanStack Query with the user"]
    FEStoreToken --> RedirectDash["React Router opens the view for the user's role"]

    CheckAccount -->|No| FESignUpForm["Sign-up form (React Hook Form + Zod):<br/>choose Coach or Player, enter account details<br/>(players may add a Riot ID)"]
    FESignUpForm --> FESignUpCall["Axios POST /api/register"]
    FESignUpCall --> TeamChoice{"Set up a team<br/>now, or later?"}
    FESignUpCall -.-> ResolvePuuid["If the player gave a Riot ID, the API resolves it<br/>to a PUUID through the Riot Account API<br/>and stores it on the user"]

    TeamChoice -->|Create a team| FETeamForm["Team form (React Hook Form + Zod):<br/>name and description"]
    FETeamForm --> FETeamCall["Axios POST /api/teams"]
    FETeamCall --> GenTeamCode["API makes a unique team code, TM-XXXXXXXX,<br/>and default team settings:<br/>keyword lists, silence threshold, timing windows"]
    GenTeamCode --> CoachMainActive["Creator becomes the main coach,<br/>an active member"]
    CoachMainActive --> IssueToken

    TeamChoice -->|Join with a code| FEJoinForm["Join form: enter a team code"]
    FEJoinForm --> FEJoinCall["Axios POST /api/teams/join"]
    FEJoinCall --> ValidateCode["API checks the code"]
    ValidateCode --> PendingRequest["Added as a pending request:<br/>player, or assistant coach"]
    PendingRequest --> MainCoachDecides{"Main coach<br/>approves?"}
    MainCoachDecides -->|"Approve, within the 5-player cap"| BecomeActive["Becomes an active member"]
    MainCoachDecides -->|Reject| RejectedMember["Request rejected;<br/>user stays teamless"]
    BecomeActive --> IssueToken
    RejectedMember --> IssueToken

    TeamChoice -->|Skip for now| Teamless["No team yet;<br/>can join one later"]
    Teamless --> IssueToken

    RedirectDash --> FEDash["Team view (React): TanStack Query loads<br/>GET /api/teams and GET /api/dashboard/header"]
    FEDash --> RoleGate{"User's team<br/>role?"}

    RoleGate -->|Main coach| ManageTeam["Coach UI: approve or remove members,<br/>edit team settings, and run sessions"]
    RoleGate -->|Assistant coach| AssistantCoach["Coach UI: run sessions;<br/>no membership control"]
    RoleGate -->|Player| PlayerView["Player UI: see and join the team's sessions"]

    ManageTeam --> FECreateSession["Coach names a session;<br/>Axios POST /api/teams/{team}/sessions"]
    AssistantCoach --> FECreateSession
    FECreateSession --> SystemCreateSession["API creates the session, one game per session,<br/>gives it a code like SESSION_048,<br/>and adds the coach as the first participant"]
    SystemCreateSession --> LobbyState["Session is waiting to start (queuing).<br/>No timeline yet."]

    LobbyState --> FELobby["SESSION LOBBY (React): the client subscribes to the<br/>session channel via Laravel Echo + Pusher-js"]
    FELobby --> PlayersJoin["Team members join the session<br/>(Axios POST /api/sessions/{id}/join)"]
    PlayerView --> FEJoinFromList["Player opens the team's session from the list"]
    FEJoinFromList --> PlayersJoin
    PlayersJoin --> RecordParticipants[("SESSION_PARTICIPANTS:<br/>one row per person, with a team-role snapshot<br/>and their Riot id for this game")]
    RecordParticipants --> FELiveLobby["Lobby updates arrive as real-time events over Echo:<br/>participant joined or left, status changed"]
    FELiveLobby --> Consent["Each player is asked to consent to being recorded<br/>(Axios POST /api/sessions/{id}/consent)"]
    Consent --> ConsentGate{"Every present player has<br/>consented, and there is<br/>at least one player?"}
    ConsentGate -->|Not yet| FELobby
    ConsentGate -->|Yes| CanStart["Coach can start the session"]

    CanStart --> StartSession["Coach starts the session<br/>(Axios POST /api/sessions/{id}/start)"]
    StartSession --> MoveInProgress["Session moves to recording (in_progress);<br/>consented players move to a recording state"]
    MoveInProgress --> NotifyPlayers["Players' clients receive the status event over Echo:<br/>recording has begun"]
    NotifyPlayers --> Capture["Each player's browser records their own microphone<br/>audio and screen video with MediaRecorder"]
    Capture --> PlayGame["The team plays the game"]
    PlayGame --> FEStopRecording["On stop, fix-webm-duration patches the<br/>WebM duration header on each recording"]
    FEStopRecording --> CoachCompletes["When the game ends, the coach submits one form<br/>(React Hook Form, multipart Axios POST /api/sessions/{id}/complete):<br/>every recording player's audio and video, plus either a<br/>Riot match id or the match events typed in by hand"]

    CoachCompletes --> StoreFiles["API saves the uploaded files"]
    StoreFiles --> AODRecords[("AOD_RECORDS")]
    StoreFiles --> VODRecords[("VOD_RECORDS")]

    CoachCompletes --> MatchSource{"Riot match id supplied,<br/>or found from the players'<br/>recent matches?"}
    MatchSource -->|Yes| RiotMatchRow[("RIOT_MATCHES:<br/>queued for import")]
    MatchSource -->|No| ManualEvents["The coach's typed-in events are saved"]
    ManualEvents --> GameEventRows[("GAME_EVENTS:<br/>source = manual")]

    CoachCompletes --> CreateTimeline["Session moves to processing;<br/>the session's timeline is created now"]
    CreateTimeline --> TimelinesRow[("TIMELINES")]
    CreateTimeline -.-> note1["Without Riot data the prototype still lines audio,<br/>video and match up from a shared start,<br/>with no drift correction"]
    CreateTimeline -.-> FEProcessing["Client shows a processing view; transcription and<br/>Riot-import progress stream in over Echo + Pusher-js"]

    RiotMatchRow --> FetchRiot["Queue job calls the Riot API:<br/>match details and match timeline"]
    FetchRiot --> RiotOk{"Riot returned the match,<br/>and it is accessible?"}
    RiotOk -->|No| RiotFailed["Mark the Riot import failed;<br/>the coach adds events by hand during review"]
    RiotOk -->|Yes| MapRiot["Map Riot rounds and events to GAME_EVENTS<br/>(source = riot): kills, deaths, assists,<br/>spike plant and defuse, round start and result"]
    MapRiot --> GameEventRiotRows[("GAME_EVENTS:<br/>source = riot")]
    MapRiot --> SyncOffset["Compute the Riot match start offset;<br/>set each recording's sync offset on the timeline"]
    SyncOffset --> TimelinesRow
    SyncOffset -.-> note4["With Riot data, audio, video and match<br/>line up on the match's own clock"]

    AODRecords --> SubmitAssembly["Send each player's audio to AssemblyAI<br/>for speech-to-text"]
    SubmitAssembly --> PollAssembly["Wait for each result;<br/>store the text, language, and confidence"]
    PollAssembly --> LangCheck{"English or Filipino,<br/>and the provider succeeded?"}
    LangCheck -->|"No"| TranscriptFailed["Mark that one transcript failed;<br/>it still counts as done"]
    LangCheck -->|Yes| TranscriptRows[("TRANSCRIPTS")]
    TranscriptRows --> FetchSentences["Fetch the sentence and word breakdown"]
    FetchSentences --> SentenceRows[("TRANSCRIPT_SENTENCES and TRANSCRIPT_WORDS")]

    SentenceRows --> LoadSettings["Load the team's keyword lists and timing settings"]
    LoadSettings --> DetectCallouts["Scan each transcript for the team's keywords,<br/>group nearby hits into one callout"]
    DetectCallouts --> CalloutRows[("COMM_EVENTS and CALLOUT_DETECTIONS")]
    DetectCallouts -.-> note2["Detection and tagging only:<br/>informative, declarative, or both.<br/>No good or bad judgment."]

    CalloutRows --> DeadAir["For every session, find stretches where the whole<br/>team was silent longer than the threshold"]
    TranscriptFailed --> DeadAir
    DeadAir --> DeadAirRows[("DEAD_AIR_PERIODS")]
    DeadAirRows --> DeadAirNote{"A match event went<br/>uncalled inside a<br/>silent stretch?"}
    DeadAirNote -->|Yes| DeadAirAnnotation["Add a system note on that stretch,<br/>naming the events that went uncalled"]
    DeadAirNote -->|No| AlignStep{"Does the session have<br/>match events?"}
    DeadAirAnnotation --> AlignStep

    GameEventRows -.-> AlignStep
    GameEventRiotRows -.-> AlignStep
    RiotFailed -.-> AlignStep

    AlignStep -->|Yes| Alignment["For callouts near a match event, add a soft note:<br/>possibly positive, possibly negative, or neutral"]
    Alignment --> AlignmentRows[("ANNOTATIONS, topic game_state_alignment")]
    AlignStep -->|No| ReadyGate{"Transcripts done, callouts found, silence checked,<br/>Riot import finished or waived, and alignment<br/>checked when there are match events?"}
    AlignmentRows -.-> note3["A hedged read of the moment,<br/>not a verdict on the call.<br/>The coach still judges."]
    AlignmentRows --> ReadyGate

    ReadyGate -->|Not yet| WaitMore["Wait for the remaining steps"]
    WaitMore --> ReadyGate
    ReadyGate -->|Yes| ReadyForReview["Session moves to<br/>ready for coach review (timeline_ready)"]

    ReadyForReview --> FEReviewBoard["Coach review UI (React), coach-only: TanStack Query<br/>loads GET /api/sessions/{id}/timeline and /timeline-summary;<br/>GSAP drives timeline scrubbing and playback"]
    FEReviewBoard --> ReviewBoard["Shows callouts per player, match events, silent<br/>stretches, notes, captions, and each recording's details"]
    ReviewBoard --> CoachActions["Coach reviews the imported match events, adds manual<br/>callouts or silent stretches, edits or deletes entries,<br/>writes notes, replies, and signs off each entry<br/>(Axios POST, PUT, DELETE; the list refetches)"]
    ReviewBoard -.->|"re-analyze with updated settings"| LoadSettings
    CoachActions --> ReviewComplete{"Every entry<br/>signed off?"}
    ReviewComplete -->|No| ReviewBoard
    ReviewComplete -->|Yes| ShareWithTeam["Coach marks it shared with the team (analysis_ready)"]
    ShareWithTeam --> PlayerReview["Players' clients receive the analysis_ready event;<br/>the timeline routes open to them"]
    PlayerReview --> PlayerActions["Players view the callouts, match events, and notes,<br/>and add their own notes and replies (Axios)"]
    PlayerActions --> Reopen{"Coach reopens<br/>review?"}
    Reopen -->|Yes| ReviewBoard
    Reopen -->|No| Completed(["Completed post-game analysis"])

    Completed --> Dashboard["Recent shared sessions roll up into the team dashboard<br/>(TanStack Query): communication rate, alignment rate,<br/>silence, and per-player lines"]
    Dashboard --> FutureTraining["Kept for tracking communication habits over time"]
    FutureTraining --> End([End])

