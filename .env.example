# The API origin only; the client appends `/api` and `/broadcasting/auth`.
VITE_API_URL=http://localhost:8000

# Pusher Channels, which is what the backend broadcasts over. Leave both blank
# and the live-updates adapter connects to nothing and reports itself
# disconnected: the app still starts and the tests still run (ADR 0011).
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
